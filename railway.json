{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "providers": ["java"],
      "phases": {
        "install": {
          "cmds": ["apt-get update && apt-get install -y maven"]
        },
        "build": {
          "cmds": ["mvn clean package -DskipTests"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "java -jar target/mvc_user_manage-1.0-SNAPSHOT.jar",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
